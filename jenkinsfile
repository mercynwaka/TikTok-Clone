pipeline {
    agent any
    environment  {
        IMAGE_NAME = 'mercynwaka/tiktok-clone'   
        GITHUB_URL = 'https://github.com/mercynwaka/tiktok-clone.git'
        DOCKER_USER = 'mercynwaka'
    
    }
    stages {
        stage('Get App Code') {
            steps {
                echo 'Getting the Application Source Code'
                git branch: 'master', url: GITHUB_URL
            }
        }
        stage('build image') {
            steps {
               echo 'building the docker image'
               sh 'CI=false npm run build'
               sh "docker build -t $IMAGE_NAME ."
            }
        }
        stage('docker login') {
            steps {
               echo 'login and push docker image to repo'
               withCredentials([string(credentialsId: 'Docker-hub-pat', variable: 'DOCKER_PASS')]) {

               sh "echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin"
               sh "docker push $IMAGE_NAME"
              
                } 

               
                
            }
        }
    }
    post {
        always {
            sh 'docker logout'
        }
    }
}